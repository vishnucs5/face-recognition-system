# Face Recognition System Configuration

# Face Detection Threshold (0.0 to 1.0)
DETECTION_THRESHOLD=0.60

# Face Matching Cosine Similarity Threshold (0.0 to 1.0)
# Default 0.45 balances False Accept Rate (FAR) and False Reject Rate (FRR) for SFace.
MATCH_THRESHOLD=0.45

# Multi-embedding strategy for matching against a person: 'max' or 'mean'
MATCHING_STRATEGY=max

# Inference Device: 'auto', 'cpu', or 'cuda'
DEVICE=auto

# Database Path
DATABASE_PATH=data/database/faces.db

# Quality Checks
MIN_FACE_SIZE=60
MIN_LAPLACIAN_VARIANCE=25.0
MAX_IMAGE_DIMENSION=1920

# Model Paths (optional overrides; will download automatically if missing)
YUNET_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
SFACE_MODEL_PATH=models/face_recognition_sface_2021dec.onnx
